{
  "$id": "https://ynaito.dev/schemas/ops-evidence/events/v1/analysis-requested.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysisId": {
      "format": "uuid",
      "title": "Analysisid",
      "type": "string"
    },
    "correlationId": {
      "format": "uuid",
      "title": "Correlationid",
      "type": "string"
    },
    "eventId": {
      "format": "uuid",
      "title": "Eventid",
      "type": "string"
    },
    "eventType": {
      "const": "analysis.requested",
      "default": "analysis.requested",
      "title": "Eventtype",
      "type": "string"
    },
    "incidentId": {
      "format": "uuid",
      "title": "Incidentid",
      "type": "string"
    },
    "inputUri": {
      "pattern": "^/internal/v1/analyses/.+/input$",
      "title": "Inputuri",
      "type": "string"
    },
    "occurredAt": {
      "format": "date-time",
      "title": "Occurredat",
      "type": "string"
    },
    "scenarioId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenarioid"
    },
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "traceparent": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Traceparent"
    }
  },
  "required": [
    "eventId",
    "occurredAt",
    "analysisId",
    "correlationId",
    "incidentId",
    "inputUri"
  ],
  "title": "AnalysisRequestedEvent",
  "type": "object"
}
