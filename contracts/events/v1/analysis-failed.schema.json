{
  "$defs": {
    "AnalysisFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 80,
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "detail",
        "retryable"
      ],
      "title": "AnalysisFailure",
      "type": "object"
    }
  },
  "$id": "https://ynaito.dev/schemas/ops-evidence/events/v1/analysis-failed.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysisId": {
      "format": "uuid",
      "title": "Analysisid",
      "type": "string"
    },
    "correlationId": {
      "format": "uuid",
      "title": "Correlationid",
      "type": "string"
    },
    "eventId": {
      "format": "uuid",
      "title": "Eventid",
      "type": "string"
    },
    "eventType": {
      "const": "analysis.failed",
      "default": "analysis.failed",
      "title": "Eventtype",
      "type": "string"
    },
    "failure": {
      "$ref": "#/$defs/AnalysisFailure"
    },
    "occurredAt": {
      "format": "date-time",
      "title": "Occurredat",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "traceparent": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Traceparent"
    }
  },
  "required": [
    "eventId",
    "occurredAt",
    "analysisId",
    "correlationId",
    "failure"
  ],
  "title": "AnalysisFailedEvent",
  "type": "object"
}
