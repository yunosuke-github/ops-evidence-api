{
  "components": {
    "schemas": {
      "AlertInput": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "firedAt": {
            "format": "date-time",
            "title": "Firedat",
            "type": "string"
          },
          "id": {
            "maxLength": 120,
            "minLength": 3,
            "pattern": "^[a-z]+:[A-Za-z0-9._-]+$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "source": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "source",
          "firedAt",
          "description"
        ],
        "title": "AlertInput",
        "type": "object"
      },
      "AnalysisFailure": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 80,
            "pattern": "^[A-Z][A-Z0-9_]+$",
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Detail",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "detail",
          "retryable"
        ],
        "title": "AnalysisFailure",
        "type": "object"
      },
      "AnalysisMetadata": {
        "additionalProperties": false,
        "properties": {
          "deterministic": {
            "default": false,
            "title": "Deterministic",
            "type": "boolean"
          },
          "inputTokens": {
            "minimum": 0.0,
            "title": "Inputtokens",
            "type": "integer"
          },
          "latencyMs": {
            "minimum": 0.0,
            "title": "Latencyms",
            "type": "integer"
          },
          "model": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Model",
            "type": "string"
          },
          "outputTokens": {
            "minimum": 0.0,
            "title": "Outputtokens",
            "type": "integer"
          },
          "promptVersion": {
            "maxLength": 40,
            "minLength": 1,
            "title": "Promptversion",
            "type": "string"
          },
          "provider": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model",
          "promptVersion",
          "inputTokens",
          "outputTokens",
          "latencyMs"
        ],
        "title": "AnalysisMetadata",
        "type": "object"
      },
      "AnalysisResponse": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "failure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisFailure"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "incidentId": {
            "format": "uuid",
            "title": "Incidentid",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/AnalysisStatus"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "id",
          "incidentId",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "title": "AnalysisResponse",
        "type": "object"
      },
      "AnalysisResult": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceItem"
            },
            "minItems": 1,
            "title": "Evidence",
            "type": "array"
          },
          "hypotheses": {
            "items": {
              "$ref": "#/components/schemas/Hypothesis"
            },
            "minItems": 1,
            "title": "Hypotheses",
            "type": "array"
          },
          "informationGaps": {
            "items": {
              "$ref": "#/components/schemas/InformationGap"
            },
            "title": "Informationgaps",
            "type": "array"
          },
          "metadata": {
            "$ref": "#/components/schemas/AnalysisMetadata"
          },
          "nextChecks": {
            "items": {
              "$ref": "#/components/schemas/NextCheck"
            },
            "title": "Nextchecks",
            "type": "array"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "title": "Observations",
            "type": "array"
          },
          "timeline": {
            "items": {
              "$ref": "#/components/schemas/TimelineEntry"
            },
            "title": "Timeline",
            "type": "array"
          }
        },
        "required": [
          "evidence",
          "timeline",
          "observations",
          "hypotheses",
          "informationGaps",
          "nextChecks",
          "metadata"
        ],
        "title": "AnalysisResult",
        "type": "object"
      },
      "AnalysisStatus": {
        "enum": [
          "queued",
          "analyzing",
          "completed",
          "failed"
        ],
        "title": "AnalysisStatus",
        "type": "string"
      },
      "EvidenceItem": {
        "additionalProperties": false,
        "properties": {
          "excerpt": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Excerpt",
            "type": "string"
          },
          "id": {
            "maxLength": 120,
            "minLength": 3,
            "pattern": "^[a-z]+:[A-Za-z0-9._-]+$",
            "title": "Id",
            "type": "string"
          },
          "sourceType": {
            "enum": [
              "alert",
              "log",
              "runbook"
            ],
            "title": "Sourcetype",
            "type": "string"
          },
          "summary": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "id",
          "sourceType",
          "summary",
          "excerpt"
        ],
        "title": "EvidenceItem",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "Hypothesis": {
        "additionalProperties": false,
        "properties": {
          "contradictingEvidenceIds": {
            "items": {
              "maxLength": 120,
              "minLength": 3,
              "pattern": "^[a-z]+:[A-Za-z0-9._-]+$",
              "type": "string"
            },
            "title": "Contradictingevidenceids",
            "type": "array"
          },
          "evidenceScore": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Evidencescore",
            "type": "integer"
          },
          "id": {
            "pattern": "^hypothesis:[A-Za-z0-9._-]+$",
            "title": "Id",
            "type": "string"
          },
          "summary": {
            "maxLength": 1500,
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          },
          "supportingEvidenceIds": {
            "items": {
              "maxLength": 120,
              "minLength": 3,
              "pattern": "^[a-z]+:[A-Za-z0-9._-]+$",
              "type": "string"
            },
            "minItems": 1,
            "title": "Supportingevidenceids",
            "type": "array"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "summary",
          "evidenceScore",
          "supportingEvidenceIds"
        ],
        "title": "Hypothesis",
        "type": "object"
      },
      "IncidentCreate": {
        "additionalProperties": false,
        "properties": {
          "alert": {
            "$ref": "#/components/schemas/AlertInput"
          },
          "logs": {
            "$ref": "#/components/schemas/LogsInput"
          },
          "runbook": {
            "$ref": "#/components/schemas/RunbookInput"
          },
          "scenarioId": {
            "anyOf": [
              {
                "maxLength": 80,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenarioid"
          },
          "title": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "alert",
          "logs",
          "runbook"
        ],
        "title": "IncidentCreate",
        "type": "object"
      },
      "IncidentResponse": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "scenarioId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenarioid"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "scenarioId",
          "createdAt"
        ],
        "title": "IncidentResponse",
        "type": "object"
      },
      "InformationGap": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "id": {
            "pattern": "^gap:[A-Za-z0-9._-]+$",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "description"
        ],
        "title": "InformationGap",
        "type": "object"
      },
      "InvalidParameter": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "name",
          "reason"
        ],
        "title": "InvalidParameter",
        "type": "object"
      },
      "LogsInput": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 128000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "format": {
            "enum": [
              "jsonl",
              "text"
            ],
            "title": "Format",
            "type": "string"
          }
        },
        "required": [
          "format",
          "content"
        ],
        "title": "LogsInput",
        "type": "object"
      },
      "NextCheck": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "hypothesisIds": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Hypothesisids",
            "type": "array"
          },
          "id": {
            "pattern": "^check:[A-Za-z0-9._-]+$",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "description",
          "hypothesisIds"
        ],
        "title": "NextCheck",
        "type": "object"
      },
      "Observation": {
        "additionalProperties": false,
        "properties": {
          "evidenceIds": {
            "items": {
              "maxLength": 120,
              "minLength": 3,
              "pattern": "^[a-z]+:[A-Za-z0-9._-]+$",
              "type": "string"
            },
            "minItems": 1,
            "title": "Evidenceids",
            "type": "array"
          },
          "id": {
            "pattern": "^observation:[A-Za-z0-9._-]+$",
            "title": "Id",
            "type": "string"
          },
          "statement": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Statement",
            "type": "string"
          }
        },
        "required": [
          "id",
          "statement",
          "evidenceIds"
        ],
        "title": "Observation",
        "type": "object"
      },
      "ProblemDetails": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/InvalidParameter"
            },
            "title": "Errors",
            "type": "array"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "RunbookInput": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 64000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "id": {
            "maxLength": 120,
            "minLength": 3,
            "pattern": "^[a-z]+:[A-Za-z0-9._-]+$",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "content"
        ],
        "title": "RunbookInput",
        "type": "object"
      },
      "TimelineEntry": {
        "additionalProperties": false,
        "properties": {
          "evidenceIds": {
            "items": {
              "maxLength": 120,
              "minLength": 3,
              "pattern": "^[a-z]+:[A-Za-z0-9._-]+$",
              "type": "string"
            },
            "minItems": 1,
            "title": "Evidenceids",
            "type": "array"
          },
          "summary": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "timestamp",
          "summary",
          "evidenceIds"
        ],
        "title": "TimelineEntry",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Evidence-grounded incident analysis with reliable asynchronous boundaries.",
    "title": "OpsEvidence API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/analyses/{analysis_id}": {
      "get": {
        "operationId": "get_analysis_v1_analyses__analysis_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "analysis_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Analysis Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Analysis",
        "tags": [
          "analyses"
        ]
      }
    },
    "/v1/incidents": {
      "post": {
        "operationId": "create_incident_v1_incidents_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IncidentCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Incident",
        "tags": [
          "incidents"
        ]
      }
    },
    "/v1/incidents/{incident_id}": {
      "get": {
        "operationId": "get_incident_v1_incidents__incident_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "incident_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Incident Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Incident",
        "tags": [
          "incidents"
        ]
      }
    },
    "/v1/incidents/{incident_id}/analyses": {
      "post": {
        "operationId": "start_analysis_v1_incidents__incident_id__analyses_post",
        "parameters": [
          {
            "in": "path",
            "name": "incident_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Incident Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "title": "Idempotency-Key",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "traceparent",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "pattern": "^[\\da-f]{2}-[\\da-f]{32}-[\\da-f]{16}-[\\da-f]{2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Traceparent"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start Analysis",
        "tags": [
          "analyses"
        ]
      }
    }
  }
}
