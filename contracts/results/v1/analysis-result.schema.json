{
  "$defs": {
    "AnalysisMetadata": {
      "additionalProperties": false,
      "properties": {
        "deterministic": {
          "default": false,
          "title": "Deterministic",
          "type": "boolean"
        },
        "inputTokens": {
          "minimum": 0,
          "title": "Inputtokens",
          "type": "integer"
        },
        "latencyMs": {
          "minimum": 0,
          "title": "Latencyms",
          "type": "integer"
        },
        "model": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "outputTokens": {
          "minimum": 0,
          "title": "Outputtokens",
          "type": "integer"
        },
        "promptVersion": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Promptversion",
          "type": "string"
        },
        "provider": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "promptVersion",
        "inputTokens",
        "outputTokens",
        "latencyMs"
      ],
      "title": "AnalysisMetadata",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "excerpt": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "id": {
          "maxLength": 120,
          "minLength": 3,
          "pattern": "^[a-z]+:[A-Za-z0-9._-]+$",
          "title": "Id",
          "type": "string"
        },
        "sourceType": {
          "enum": [
            "alert",
            "log",
            "runbook"
          ],
          "title": "Sourcetype",
          "type": "string"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sourceType",
        "summary",
        "excerpt"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "contradictingEvidenceIds": {
          "items": {
            "maxLength": 120,
            "minLength": 3,
            "pattern": "^[a-z]+:[A-Za-z0-9._-]+$",
            "type": "string"
          },
          "title": "Contradictingevidenceids",
          "type": "array"
        },
        "evidenceScore": {
          "maximum": 100,
          "minimum": 0,
          "title": "Evidencescore",
          "type": "integer"
        },
        "id": {
          "pattern": "^hypothesis:[A-Za-z0-9._-]+$",
          "title": "Id",
          "type": "string"
        },
        "summary": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "supportingEvidenceIds": {
          "items": {
            "maxLength": 120,
            "minLength": 3,
            "pattern": "^[a-z]+:[A-Za-z0-9._-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Supportingevidenceids",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "evidenceScore",
        "supportingEvidenceIds"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "InformationGap": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^gap:[A-Za-z0-9._-]+$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "InformationGap",
      "type": "object"
    },
    "NextCheck": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "hypothesisIds": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Hypothesisids",
          "type": "array"
        },
        "id": {
          "pattern": "^check:[A-Za-z0-9._-]+$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "hypothesisIds"
      ],
      "title": "NextCheck",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "evidenceIds": {
          "items": {
            "maxLength": 120,
            "minLength": 3,
            "pattern": "^[a-z]+:[A-Za-z0-9._-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        },
        "id": {
          "pattern": "^observation:[A-Za-z0-9._-]+$",
          "title": "Id",
          "type": "string"
        },
        "statement": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement",
        "evidenceIds"
      ],
      "title": "Observation",
      "type": "object"
    },
    "TimelineEntry": {
      "additionalProperties": false,
      "properties": {
        "evidenceIds": {
          "items": {
            "maxLength": 120,
            "minLength": 3,
            "pattern": "^[a-z]+:[A-Za-z0-9._-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "summary",
        "evidenceIds"
      ],
      "title": "TimelineEntry",
      "type": "object"
    }
  },
  "$id": "https://ynaito.dev/schemas/ops-evidence/results/v1/analysis-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "minItems": 1,
      "title": "Hypotheses",
      "type": "array"
    },
    "informationGaps": {
      "items": {
        "$ref": "#/$defs/InformationGap"
      },
      "title": "Informationgaps",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/AnalysisMetadata"
    },
    "nextChecks": {
      "items": {
        "$ref": "#/$defs/NextCheck"
      },
      "title": "Nextchecks",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Observations",
      "type": "array"
    },
    "timeline": {
      "items": {
        "$ref": "#/$defs/TimelineEntry"
      },
      "title": "Timeline",
      "type": "array"
    }
  },
  "required": [
    "evidence",
    "timeline",
    "observations",
    "hypotheses",
    "informationGaps",
    "nextChecks",
    "metadata"
  ],
  "title": "AnalysisResult",
  "type": "object"
}
